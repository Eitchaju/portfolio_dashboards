		isNameInferred
		sourceColumn: [Inicio_Mes]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Dim_Calendario = calculated
		mode: import
		source = ```
				
				VAR DataInicial =
				    MINX(
				        Fato_Atendimentos,
				        Fato_Atendimentos[data_atendimento]
				    )
				VAR DataFinal =
				    MAXX(
				        Fato_Atendimentos,
				        Fato_Atendimentos[data_atendimento]
				    )
				RETURN
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(YEAR(DataInicial), 1, 1),
				        DATE(YEAR(DataFinal), 12, 31)
				    ),
				    "Ano", YEAR([Date]),
				    "Mes_Numero", MONTH([Date]),
				    "Mes_Nome", FORMAT([Date], "mmmm"),
				    "Ano_Mes", FORMAT([Date], "yyyy-MM"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "Inicio_Mes", DATE(YEAR([Date]), MONTH([Date]), 1)
				)
				
				```

	annotation PBI_Id = 68a24aa74804413ca4c02215b9b97163

